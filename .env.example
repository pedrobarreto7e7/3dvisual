# Copie para .env e preencha ao menos uma chave para converter fotos de verdade.
# Sem nenhuma chave, o app roda em "modo demonstração".

# Meshy — https://www.meshy.ai/settings/api  (recomendado: Meshy 7 + PBR + texturas 4K)
MESHY_API_KEY=

# Tripo — https://platform.tripo3d.ai/  (chaves começam com tsk_)
TRIPO_API_KEY=
# Use https://openapi.tripo3d.com/v3 se sua conta for da região China
TRIPO_API_BASE=https://openapi.tripo3d.ai/v3

# Porta do servidor da API (o Vite usa 5173 em desenvolvimento)
PORT=8787
# Pasta onde fotos e modelos gerados são guardados
DATA_DIR=./data
